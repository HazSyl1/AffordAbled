NEMO_GUARDRAILS_ALLOW_TOKEN=__ALLOW__
NEMO_GUARDRAILS_NEEDS_CLASSIFICATION_TOKEN=__NEEDS_CLASSIFICATION__
LANGGRAPH_CHECKPOINTER_MODE=auto
LANGGRAPH_CHECKPOINTER_STARTUP_TIMEOUT_SECONDS=8
RETENTION_CLEANUP_ENABLED=false
RETENTION_CLEANUP_INTERVAL_MINUTES=60
CHAT_MESSAGE_RETENTION_DAYS=180
