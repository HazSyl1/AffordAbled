# Split payment SMS reminders. Leave disabled until ACS is configured.
SMS_ENABLED=false
# Public API URL (https) so the email's Pay with UPI button can open a hosted payment page.
# e.g. PUBLIC_API_BASE_URL=https://affordabled-api-c8ewaeajgjf0ehhf.centralindia-01.azurewebsites.net
PUBLIC_API_BASE_URL=
PUBLIC_WEB_URL=https://icy-dune-025d50600.6.azurestaticapps.net
EMAIL_ENABLED=false
EMAIL_PROVIDER=azure_acs
EMAIL_SENDER_ADDRESS=
EMAIL_WORKER_ENABLED=true
EMAIL_WORKER_BATCH_SIZE=20
EMAIL_WORKER_POLL_SECONDS=5
EMAIL_PROCESSING_STALE_SECONDS=120
EMAIL_SEND_TIMEOUT_SECONDS=30
SMS_PROVIDER=azure_acs
ACS_CONNECTION_STRING=
ACS_SENDER_NUMBER=
NOTIFICATION_COOLDOWN_HOURS=6
MAX_NOTIFICATIONS_PER_SPLIT=3
MAX_SMS_PER_USER_PER_DAY=10
SMS_WORKER_ENABLED=true
SMS_WORKER_BATCH_SIZE=20
SMS_WORKER_POLL_SECONDS=5
SMS_PROCESSING_STALE_SECONDS=120
SMS_SEND_TIMEOUT_SECONDS=15

JWT_SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# Include the native Capacitor origins for mobile builds when using the hosted API.
# Example: http://localhost:5173,https://localhost,capacitor://localhost,https://your-web-host
CORS_ALLOWED_ORIGINS=http://localhost:5173

AZURE_STORAGE_ACCOUNT_NAME=
AZURE_STORAGE_CONTAINER_NAME=
