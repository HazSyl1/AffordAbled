APP_ENV=development
LOG_LEVEL=INFO
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/affordable
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0

JWT_SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

CORS_ALLOWED_ORIGINS=http://localhost:5173

AZURE_STORAGE_ACCOUNT_NAME=
AZURE_STORAGE_CONTAINER_NAME=
AZURE_DOCUMENT_INTELLIGENCE_ENDPOINT=
AZURE_DOCUMENT_INTELLIGENCE_KEY=
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=centralindia
FFMPEG_BINARY=ffmpeg
AUDIO_TRANSCODE_TIMEOUT_SECONDS=15
AUDIO_TRANSCODER_REQUIRED=false
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_API_VERSION=2024-10-21
AZURE_OPENAI_EXTRACTION_DEPLOYMENT=

CHAT_PROPOSAL_CONFIDENCE_THRESHOLD=80
CHAT_HITL_MAX_TURNS=5
CHAT_DETERMINISTIC_TRANSACTION_FIRST=true
CHAT_GUARDRAIL_PROVIDER=nemo
CHAT_INTENT_PROVIDER=keyword
NEMO_GUARDRAILS_CONFIG_PATH=app/infrastructure/ai/nemo_guardrails
NEMO_GUARDRAILS_BLOCK_TOKEN=__BLOCK__
NEMO_GUARDRAILS_ALLOW_TOKEN=__ALLOW__
NEMO_GUARDRAILS_NEEDS_CLASSIFICATION_TOKEN=__NEEDS_CLASSIFICATION__
LANGGRAPH_CHECKPOINTER_MODE=auto
LANGGRAPH_CHECKPOINTER_STARTUP_TIMEOUT_SECONDS=8
RETENTION_CLEANUP_ENABLED=false
RETENTION_CLEANUP_INTERVAL_MINUTES=60
CHAT_MESSAGE_RETENTION_DAYS=180

LANGSMITH_API_KEY=
LANGSMITH_TRACING=false
LANGSMITH_PROJECT=affordabled-dev
